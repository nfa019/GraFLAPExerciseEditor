$result6=&cas('maxima',"set($auto[6]);"); # finals
if ($auto[7] eq "nd") { $det = 1; } else { $det = 0;}
$tr = "Text";
$transitionsTeX = $auto[8];

$set4 = $auto[4];
$set4 =~ s/\(/[/g;
$set4 =~ s/\)/]/g;
$result4=&cas('maxima',"set($set4);"); # Delta
</script>
